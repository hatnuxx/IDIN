{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IDIN",
  "version": "1.0.1",
  "identifier": "com.hatnux.idin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IDIN",
        "width": 980,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/idin-host.exe", "resources/extension/*"],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
